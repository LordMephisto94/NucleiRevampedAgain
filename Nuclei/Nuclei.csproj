<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <AssemblyName>NucleiRevamped</AssemblyName>
        <RootNamespace>Nuclei</RootNamespace>
        <Product>NucleiRevamped</Product>
        <Title>NucleiRevamped</Title>
        <Description>Server-side admin tools for the official Nuclear Option dedicated server.</Description>
        <Version>2.0.0</Version>
        <Authors>MaxWasUnavailable, Battle8111, LordMephisto94</Authors>
        <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/LordMephisto94/NucleiRevampedAgain</RepositoryUrl>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <!-- Publicizer produces duplicate-type warnings; harmless. -->
        <NoWarn>$(NoWarn);CS0436</NoWarn>

        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json
        </RestoreAdditionalProjectSources>

        <!--
            Folder holding the game's managed DLLs (Assembly-CSharp.dll etc).
            Either the client (NuclearOption_Data/Managed) or the dedicated server
            (NuclearOptionServer_Data/Managed) works; both share the same game code.
            Override with: dotnet build -p:NuclearOptionManaged=/path/to/Managed
            or the NUCLEAR_OPTION_MANAGED environment variable.
        -->
        <NuclearOptionManaged Condition="'$(NuclearOptionManaged)' == ''">$(NUCLEAR_OPTION_MANAGED)</NuclearOptionManaged>
        <NuclearOptionManaged Condition="'$(NuclearOptionManaged)' == ''">$(MSBuildThisFileDirectory)../lib</NuclearOptionManaged>

        <!-- Optional: copy the built DLL into a BepInEx/plugins folder after Release builds. -->
        <PluginDestination Condition="'$(PluginDestination)' == ''">$(NUCLEAR_OPTION_PLUGINS)</PluginDestination>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" ExcludeAssets="runtime"/>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.Core" Version="5.4.*"/>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*"/>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp" HintPath="$(NuclearOptionManaged)/Assembly-CSharp.dll" Private="False" Publicize="True"/>
        <Reference Include="UnityEngine" HintPath="$(NuclearOptionManaged)/UnityEngine.dll" Private="False"/>
        <Reference Include="UnityEngine.CoreModule" HintPath="$(NuclearOptionManaged)/UnityEngine.CoreModule.dll" Private="False"/>
        <Reference Include="UniTask" HintPath="$(NuclearOptionManaged)/UniTask.dll" Private="False"/>
        <Reference Include="Mirage" HintPath="$(NuclearOptionManaged)/Mirage.dll" Private="False"/>
        <Reference Include="com.rlabrecque.steamworks.net" HintPath="$(NuclearOptionManaged)/com.rlabrecque.steamworks.net.dll" Private="False"/>
    </ItemGroup>

    <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(PluginDestination)' != ''">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDestination)/$(AssemblyName)"/>
        <Message Text="Copied $(TargetFileName) to $(PluginDestination)/$(AssemblyName)" Importance="high"/>
    </Target>
</Project>
